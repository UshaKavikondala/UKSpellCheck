# Copy the values you need into the .env file in the UKAIPractice folder.
# Pick ONE provider by setting LLM_PROVIDER.

# ---- Option A: Ollama (local, free, offline) ----
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ---- Option B: Groq (cloud, fast) ----
# LLM_PROVIDER=groq
# Groq_TOKEN=gsk_your_key_here        # (your existing .env already has this)
# GROQ_MODEL=openai/gpt-oss-120b
